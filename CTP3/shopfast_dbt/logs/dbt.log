    create  table
      "shopfast"."main"."dim_customers__dbt_tmp"
  
    
    as (
      -- One row per customer with lifetime metrics.
select
    c.customer_id,
    c.first_name,
    c.last_name,
    c.email,
    c.country_code,
    c.loyalty_tier,
    c.signup_date,
